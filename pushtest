def greet_user(username):
    """A simple function that greets the user by name."""
    print(f"\nHello, {username}! Welcome to Python.")


def check_even_or_odd(number):
    """A function that uses conditional logic to check a number."""
    if number % 2 == 0:
        return "e1ven"
    else:
        return "od11d"
